# Executable discovery. Command names use the system PATH by default.
CLEARFRAME_FFMPEG=ffmpeg
CLEARFRAME_FFPROBE=ffprobe

# These paths remain configurable because this repository is inside OneDrive.
CLEARFRAME_MODEL_DIR=data/models
CLEARFRAME_TEMP_DIR=data/temp

# Initial quality baseline. CLI arguments will override these values.
CLEARFRAME_MODEL=realesrgan-x4plus
CLEARFRAME_CRF=18
CLEARFRAME_TILE_SIZE=auto
CLEARFRAME_DEVICE=auto
CLEARFRAME_BATCH_SIZE=1
CLEARFRAME_ENCODER_PRESET=medium
CLEARFRAME_AAC_BITRATE_KBPS=192
